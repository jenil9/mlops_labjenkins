pipeline {

    agent {
        node {
            label 'local'
            // customWorkspace '/Users/jenilbuha/Desktop/sem7/Mlops/microservice'
        }
    }

    environment {
        PATH = "${env.HOME}/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:${env.PATH}"
        PROJECT_DIR = '/Users/jenilbuha/Desktop/sem7/Mlops/microservice'
    }


    stages {
        stage('Checkout Code') {
    steps {
        checkout scm
    }
}

        stage('Show Workspace') {
            steps {
                dir(env.PROJECT_DIR) {
                    sh 'pwd'
                    sh 'ls'
                }
            }
        }

        stage('Check Docker') {
            steps {
                dir(env.PROJECT_DIR) {
                    sh 'docker --version'
                    sh 'docker compose version'
                }
            }
        }


        stage('Build Images') {
            steps {
                dir(env.PROJECT_DIR) {
                    sh 'docker compose build'
                }
            }
        }


        stage('Run Tests') {
            steps {
                dir(env.PROJECT_DIR) {
                    sh 'docker compose run --rm webapp pytest || echo "No tests found"'
                }
            }
        }


        stage('Deploy Containers') {
            steps {
                dir(env.PROJECT_DIR) {
                    sh 'docker compose up -d'
                }
            }
        }

    }
}