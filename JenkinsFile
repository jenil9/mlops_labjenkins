pipeline {

    agent {
        node {
            label 'local'
            customWorkspace '/Users/jenilbuha/Desktop/sem7/Mlops/microservice'
        }
    }

    environment {
        PATH = "${env.HOME}/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:${env.PATH}"
    }


    stages {
        stage('Checkout Code') {
            steps {
        git branch: 'main',
            url: 'file:///Users/jenilbuha/Desktop/sem7/Mlops/microservice'
    }
        }

        stage('Show Workspace') {
            steps {
                sh 'pwd'
                sh 'ls'
            }
        }

        stage('Check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker compose version'
            }
        }


        stage('Build Images') {
            steps {
                sh 'docker compose build'
            }
        }


        stage('Run Tests') {
            steps {
                sh 'docker compose run --rm webapp pytest || echo "No tests found"'
            }
        }


        stage('Deploy Containers') {
            steps {
                sh 'docker compose up -d'
            }
        }

    }
}